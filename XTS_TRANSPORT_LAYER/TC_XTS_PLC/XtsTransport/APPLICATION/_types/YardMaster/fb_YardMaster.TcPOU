        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MessageLevel := _MessageLevel;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{940048a6-54e6-4562-9da8-ed83616a9106}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
