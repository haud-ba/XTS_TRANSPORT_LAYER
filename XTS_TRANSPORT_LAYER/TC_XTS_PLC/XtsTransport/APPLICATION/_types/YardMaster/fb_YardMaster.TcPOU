    </Property>
    <Method Name="Disable" Id="{6a1967ac-bfda-4bfa-aaf3-54c7dba01ffd}" FolderPath="methods\">
      <Declaration><![CDATA[METHOD Disable : E_PROGRESS // RemoveAllAxis from CA Group, disable CA Group, disable all movers
VAR_INPUT
  Execute     : BOOL;
END_VAR
VAR_INST
  _nErrorId   : UDINT;
  _eState     : E_PROGRESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//-----------------------------------------------------------------------------
IF NOT Execute 
THEN 
	_eState                       := E_PROGRESS.PROGRESS_INIT; 
END_IF 
//-------------------------------------------------------------------------------
IF NOT Check() 
THEN 
	Disable                       := E_PROGRESS.PROGRESS_ERROR; 
	RETURN; 
END_IF
//-------------------------------------------------------------------------------
//-------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _nErrorId                 := 0;

      _XtsTransportCtrl.Cmd     := E_XTS_TRANSPORT_CTRL.CMD_NULL;
      _eState                   := E_PROGRESS.PROGRESS_BUSY;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType            := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice       := e_Subdevice.Application_Disable;
        _stMsg.iErrorNumber     := 0;
        _stMsg.sText            := concat(TO_STRING(_eState), ': ');
        f_MessageSet(_stMsg);
      END_IF
    END_IF
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_BUSY:
    _XtsTransportCtrl.Cmd       := E_XTS_TRANSPORT_CTRL.CMD_GROUP_CLEAR; 
    _eState                     := E_PROGRESS.PROGRESS_PREPARE;
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_PREPARE:
    IF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_CLEAR + E_PROGRESS.PROGRESS_ERROR)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_BUSY;
      _XtsTransportCtrl.Cmd     := E_XTS_TRANSPORT_CTRL.CMD_NULL;

      _nErrorId                 := _XtsTransportState.GroupInfo.GroupErrorId; 

    ELSIF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_CLEAR + E_PROGRESS.PROGRESS_DONE)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_STARTUP;
    END_IF
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_STARTUP:
    _XtsTransportCtrl.Cmd       := E_XTS_TRANSPORT_CTRL.CMD_MOVER_DISABLE; 
    _eState                     := E_PROGRESS.PROGRESS_CHECK;
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_CHECK:
    IF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_MOVER_DISABLE + E_PROGRESS.PROGRESS_ERROR)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType              := E_MessageType.eMessageError;
      _stMsg.eSubdevice         := e_Subdevice.Application_Disable;
      _stMsg.iErrorNumber       := 0;
      _stMsg.sText              := concat(TO_STRING(_eState), ': ');
      f_MessageSet(_stMsg);

    ELSIF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_MOVER_DISABLE + E_PROGRESS.PROGRESS_DONE)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_DONE;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType            := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice       := e_Subdevice.Application_Disable;
        _stMsg.iErrorNumber     := 0;
        _stMsg.sText            := concat(TO_STRING(_eState), ': ');
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//-------------------------------------------------------------------------------
//-------------------------------------------------------------------------------

Disable                         := _eState;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Enable" Id="{51767aef-3d3b-4973-9946-b6ec66b91d19}" FolderPath="methods\">
      <Declaration><![CDATA[METHOD Enable : E_PROGRESS // AddAllAxis to CA Group, Enable CA Group, Enable all movers
VAR_INPUT
  Execute     : BOOL;
END_VAR
VAR_INST
  _nErrorId   : UDINT;
  _eState     : E_PROGRESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//-----------------------------------------------------------------------------
IF NOT Execute 
THEN 
	_eState                       := E_PROGRESS.PROGRESS_INIT; 
END_IF 
//-----------------------------------------------------------------------------
IF NOT Check() 
THEN 
	Enable                        := E_PROGRESS.PROGRESS_ERROR; 
	RETURN; 
END_IF
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _nErrorId                 := 0;

      _XtsTransportCtrl.Cmd     := E_XTS_TRANSPORT_CTRL.CMD_NULL;
      _eState                   := E_PROGRESS.PROGRESS_BUSY;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType            := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice       := e_Subdevice.Application_Enable;
        _stMsg.iErrorNumber     := 0;
        _stMsg.sText            := concat(TO_STRING(_eState), ': ');
        f_MessageSet(_stMsg);
      END_IF
    END_IF
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_BUSY:
    _XtsTransportCtrl.Cmd       := E_XTS_TRANSPORT_CTRL.CMD_GROUP_CLEAR;

    IF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_CLEAR + E_PROGRESS.PROGRESS_ERROR)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_ERROR;
      _nErrorId                 := _XtsTransportState.GroupInfo.GroupErrorId; 

    ELSIF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_CLEAR + E_PROGRESS.PROGRESS_DONE)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_PREPARE;
    END_IF
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_PREPARE:
    _XtsTransportCtrl.Cmd       := E_XTS_TRANSPORT_CTRL.CMD_GROUP_BUILD;

    IF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_BUILD + E_PROGRESS.PROGRESS_ERROR)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_ERROR;
      _nErrorId                 := _XtsTransportState.GroupInfo.GroupErrorId; 

    ELSIF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_BUILD + E_PROGRESS.PROGRESS_DONE)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_STARTUP;
    END_IF
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_STARTUP:
    _XtsTransportCtrl.Cmd       := E_XTS_TRANSPORT_CTRL.CMD_MOVER_ENABLE; 
    _eState                     := E_PROGRESS.PROGRESS_CHECK;
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_CHECK:
    IF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_MOVER_ENABLE + E_PROGRESS.PROGRESS_ERROR)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_ERROR;

    ELSIF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_MOVER_ENABLE + E_PROGRESS.PROGRESS_DONE)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_OCCUPIED;
    END_IF
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_OCCUPIED:
    _XtsTransportCtrl.Cmd       := E_XTS_TRANSPORT_CTRL.CMD_GROUP_ENABLE; 
    _eState                     := E_PROGRESS.PROGRESS_WORKING;
  //-----------------------------------------------------------------------------
  //-----------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_WORKING:
    IF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_ENABLE + E_PROGRESS.PROGRESS_ERROR)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType              := E_MessageType.eMessageError;
      _stMsg.eSubdevice         := e_Subdevice.Application_Enable;
      _stMsg.iErrorNumber       := 0;
      _stMsg.sText              := concat(TO_STRING(_eState), ': ');
      f_MessageSet(_stMsg);

    ELSIF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_ENABLE + E_PROGRESS.PROGRESS_DONE)
    THEN
      _eState                   := E_PROGRESS.PROGRESS_DONE;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType            := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice       := e_Subdevice.Application_Enable;
        _stMsg.iErrorNumber     := 0;
        _stMsg.sText            := concat(TO_STRING(_eState), ': ');
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------

Enable                          := _eState;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{ab722eef-0388-45b6-85d1-7a5a0fed75bd}" FolderPath="methods\">
      <Declaration><![CDATA[METHOD Init       : E_PROGRESS  
VAR_INPUT
  Execute         : BOOL;
END_VAR
VAR_INST
  _nInstance      : UINT;
  _nInstanceError : E_INSTANCE;
  _nIdx,
  _nErrorId       : UDINT;
  _eResult        : E_PROGRESS;
  _eState         : E_PROGRESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//------------------------------------------------------------------------------------------------------
IF NOT Execute 
THEN 
	_eState                                 := E_PROGRESS.PROGRESS_INIT; 
END_IF 
//------------------------------------------------------------------------------------------------------
IF NOT Check() 
THEN 
	Init                                    := E_PROGRESS.PROGRESS_ERROR; 
	RETURN; 
END_IF
//-------------------------------------------------------------------------------------------------------
//-------------------------------------------------------------------------------------------------------
CASE _eState
OF
  //-----------------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_INIT:               // startup procedure for your application
    IF Execute
    THEN
      _nInstance                          := 1;
      _nInstanceError                     := E_INSTANCE.INSTANCE_NULL;
      _eState                             := E_PROGRESS.PROGRESS_BUSY;
      _XtsTransportCtrl.Cmd               := E_XTS_TRANSPORT_CTRL.CMD_NULL;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                      := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice                 := e_Subdevice.Application_Init;
        _stMsg.iErrorNumber               := 0;
        _stMsg.sText                      := concat(TO_STRING(_eState), ': ');
        f_MessageSet(_stMsg);
      END_IF

      FOR _nIdx := 1 TO MAX_PROCESS
      DO
        _eResult                          := _ItfCollectors[_nIdx].Init(FALSE);
      END_FOR
    END_IF
  //-----------------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_BUSY:
    _XtsTransportCtrl.Cmd                 := E_XTS_TRANSPORT_CTRL.CMD_INIT;
    IF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_INIT + E_PROGRESS.PROGRESS_ERROR)
    THEN
      // XTS state is transfered to higher up
      // --> check error and plausibility checks there
      _eState                             := E_PROGRESS.PROGRESS_ERROR;
    ELSIF (_XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_INIT + E_PROGRESS.PROGRESS_DONE)
    THEN 
      _eState                             := E_PROGRESS.PROGRESS_PREPARE;
    END_IF
  //-----------------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_PREPARE:
    _eResult                              := _ItfCollectors[_nInstance].Init(TRUE);
    IF (_eResult = E_PROGRESS.PROGRESS_ERROR)
    THEN
      memcpy(ADR(_nInstanceError), ADR(_nInstance), SIZEOF(_nInstance));

      _eState                             := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                        := E_MessageType.eMessageerror;
      _stMsg.eSubdevice                   := e_Subdevice.Application_Init;
      _stMsg.iErrorNumber                 := _nInstanceError;
      _stMsg.sText                        := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                        := concat(_stMsg.sText, TO_STRING(_nInstanceError));
      f_MessageSet(_stMsg);

    ELSIF (_eResult = E_PROGRESS.PROGRESS_DONE)
    THEN
      _eState                             := E_PROGRESS.PROGRESS_STARTUP;
    END_IF
  //-----------------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_STARTUP:
    IF (_nInstance < E_INSTANCE.INSTANCE_MAX-1)
    THEN
      _nInstance                          := _nInstance + 1;
      _eState                             := E_PROGRESS.PROGRESS_PREPARE;
    ELSE
      _eState                             := E_PROGRESS.PROGRESS_CHECK;
    END_IF
  //-----------------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_CHECK:
    IF (_XtsTransportState.GroupInfo.GroupError)
    THEN
      _eState                             := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                        := E_MessageType.eMessageerror;
      _stMsg.eSubdevice                   := e_Subdevice.Application_Init;
      _stMsg.iErrorNumber                 := 0;
      _stMsg.sText                        := concat(TO_STRING(_eState), ': GroupInfo.GroupError');
      f_MessageSet(_stMsg);
    ELSE
      IF NOT (_XtsTransportState.XpuInfo.AllPositionsValid)
      THEN
        _eState                           := E_PROGRESS.PROGRESS_ERROR;
  
        _stMsg.eType                      := E_MessageType.eMessageerror;
        _stMsg.eSubdevice                 := e_Subdevice.Application_Init;
        _stMsg.iErrorNumber               := 0;
        _stMsg.sText                      := concat(TO_STRING(_eState), ': XpuInfo.AllPositionsValid');
        f_MessageSet(_stMsg);

      ELSE
        IF (_XtsTransportState.XpuInfo.IdDetectionValid) OR
           (_XtsTransportState.XpuInfo.IdDetectionMode = 0)
        THEN
          _eState                         := E_PROGRESS.PROGRESS_WORKING;
        END_IF
      END_IF
    END_IF
  //-----------------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_WORKING:
    _eState                               := E_PROGRESS.PROGRESS_DONE;

    IF (_MessageLevel > E_MessageType.eMessageError)
    THEN
      _stMsg.eType                        := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice                   := e_Subdevice.Application_Init;
      _stMsg.iErrorNumber                 := 0;
      _stMsg.sText                        := concat(TO_STRING(_eState), ': ');
      f_MessageSet(_stMsg);
    END_IF
END_CASE
//-------------------------------------------------------------------------------------------------------
//-------------------------------------------------------------------------------------------------------
Init                                      := _eState;
]]></ST>
      </Implementation>
    </Method>
