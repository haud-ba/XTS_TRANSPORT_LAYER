      </Set>
    </Property>
    <Property Name="ItfList" Id="{66c26162-a3af-4f1b-84f4-8b217101eec6}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY ItfList : I_Process_LinkedList]]></Declaration>
      <Set Name="Set" Id="{3364b06c-58b2-4046-8e0a-b974a1db0aae}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ItfList := ItfList;
]]></ST>
