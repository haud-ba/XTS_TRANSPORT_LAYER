        _stMsg.sText            := concat(_stMsg.sText, TO_STRING(_eState));
        f_MessageSet(_stMsg);
      END_IF
    END_IF
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------

ListAddTail                     := _eState;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ListDelHead" Id="{f13b9784-5392-4518-a354-839d67d9a14e}">
      <Declaration><![CDATA[METHOD ListDelHead  : e_progress
VAR_INPUT
  Execute           : BOOL;
END_VAR
VAR_INST
  _ListResult       : ST_PROCESS_LIST_RESULT;
  _nErrorId         : UDINT;
  _eState           : E_PROGRESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//-----------------------------------------------------------------------------
IF NOT Execute 
THEN 
	_eState                       := E_PROGRESS.PROGRESS_INIT; 
END_IF 
//-----------------------------------------------------------------------------
