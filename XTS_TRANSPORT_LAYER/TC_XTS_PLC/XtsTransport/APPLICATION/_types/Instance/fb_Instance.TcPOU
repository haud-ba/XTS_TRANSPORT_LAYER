<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fb_Instance" Id="{aa404a3e-1847-48a0-90da-b76021166e7c}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2026.10.15
//
//
//---------------------------------------------------------------------------------------------------------------
//  fb_Instance
//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
//  - base class for a process instance to work with fb_ProcessCollector
//  - extend this class to build top level transport logic
//    - example extensions: fb_Distributor (1 to many)
//
//  What is it that I truly desire? 
//  --> to reduce the amount of handshakes that are required for a range of XtsStation
//  --> keep the granularity of a single station also for a range of stations
//  --> reuse existing interfaces
//
//  What an Instance is for:
//  - customized administrative transport related work
//    - reading of process tickets
//    - checking of queues
//    - handshaking ranges of stations
//      - automate handshake sequences with the collectors
//    - letting the stations write station tickets
//    - writing of process tickets
//
//  How an Instance is supposed to work:
//  - An Instance is of the same nature as a fb_StationProcess.Cycle / fb_ProcessCollector.Cycle
//    
//    --> you should build a Cycle() method
//    --> the default state after self init at PowerOn shall be a disabled state
//      --> a station behaviour follows the following concept:
//        - switch on --> station moves to enabled state
//        - enabled : switch to detection
//          - detection : detect what is given to you (e.g. QueueCount or LinkedList ticket)
//          - detected work leads to station asking for permission
//        - permitted : execute whatever is mandatory for starting the process (move to position etc)
//        - start / done
//          --> you decide how to handshake
//        - ready to send out : prepare your destination data here!
//        - send out : handshake sequence for safely permitting motion of a mover and transport of information
//
//    - It is up to you to decide how much handshakes with the CollectorInterface to automate in an instance
//      - example, a default distributor may require handshakes for every mover, 
//                 a mask driven distributor distributes until he has worked through the mask autonomously
//
//    - the two enums below are suggestions
//      - maybe the existing extensions will foster ideas for your specific requirements
//
//      --> and this is how the real states are named
//             TYPE E_INSTANCE_STATE :
//             (
//               NULL,
//               INVALID,
//               INIT,
//               DISABLED,    --> default state : this is where you should end up after startup
//                                --> wait for command from higher up
//               DETECTION,   --> check for process ticket count > 0 or QueueCount > 0
//               ENABLED,     --> now CollectorInterface is enabled and we have movers arriving/waiting
//                                --> wait for command from higher up
//               WORKING,     --> now all movers have arrived or are in a process ready state 
//                                --> wait for command from higher up
//               PROCEEDING,  --> if movers need further processing (hint: mover with nests)
//                                --> wait for command from higher up
//               FINISH,      --> write the targets to stations and send the process ticket
//                                --> wait for command from higher up
//               CLEARED      --> after release, clean yourself up, then return to disabled
//             )UINT;
//             END_TYPE
//
//             TYPE E_INSTANCE_CMD : // instructions for fb_Instance executions
//             (
//               NULL,
//               INIT,        --> force init of Collectorinterface and range of xts stations
//               DISABLE,     --> command a come back from enabled
//               ENABLE,      --> switch on AND let detection run
//               WORK,        --> after seeing ENABLED, this command lets the movers enter
//                                --> after seeing WORKING, all ready for the higher ups
//               PROCEED,     --> use this for multi stop processes (nests)
//               FINISH,      --> use this AFTER having managed the targets
//               CLEAR
//             )UINT;
//             END_TYPE
//---------------------------------------------------------------------------------------------------------------
//  - ProcessId : _nProcess --> whoami, this is me
//---------------------------------------------------------------------------------------------------------------
//
//  - who is required for my work on the outside?
//  - fb_ProcessCollector[_nProcess].Cycle() is called in APPLICATION(PRG)
//    - provides interface
//    - handles range of XtsStations
//    - range must be closed and in consecutive order
//
//    - combines states into bitmasks, one bit per XtsStation
//    - controls forwarding of commands to range of XtsStations 
//      (see fb_ProcessCollector.Cycle())
//
//---------------------------------------------------------------------------------------------------------------
//  - CollectorInterface 
//---------------------------------------------------------------------------------------------------------------
//    - reference to all _ItfProcessCollector(I_ProcessCollector)[]
//    - _ItfProcessCollector[nProcess] carries ctrl/state information
//
//    - Control / State of the CollectorInterface
//      - local _stCollectorCtrl / _stCollectorState datafields are linked (REF=) to CollectorInterface.ProcessCtrl / .ProcessState
//        - since this connection shall be done automatically I put it in Check() method
//          --> see Check()
// 
//      - local datafield for control and state provided
//        - since CollectorInterface.ProcessCtrl and CollectorInterface.ProcessState are reference pointers
//          --> the real datafield has to come from somewhere, 
//              in this case the local datafields _stCollectorCtrl/_stCollectorState
//
//      - _stCollectorCtrl(ST_PROCESS_CTRL)
//        --> commands to the connected CollectorInterface;
//
//        Cmd               : E_PROCESS_CTRL; // command enum for collector
//        ProcessTarget     : UINT;           // target of my process
//        ActivateStation   : WORD;           // is checked for every job
//                                            // every bit is a XtsStation
//
//        NestMask          : BYTE;           // one mask for all XtsStations
//        - every bit is a PosStop IN a XtsStation
//
//      - _stCollectorState(ST_PROCESS_STATE)
//        --> status information from the connected CollectorInterface
//        --> check for plausible StationLast / StationFirst range of XtsStations
//
//        State             : E_PROCESS_STATE;  // state enum from collector
//        Result            : E_PROGRESS;       // substate from collector, E_PROGRESS.PROGRESS_BUSY signals the collector state is ready for interaction
//                                              // fb_Distributor may give you an idea of the use of a substate 
//        Check             : E_PROCESS_CHECK;  // plausibility check of StationLast and StationFirst (the result of Check() --> _eCheck) 
//---------------------------------------------------------------------------------------------------------------
//  - InstanceCtrl(_stInstanceCtrl) 
//---------------------------------------------------------------------------------------------------------------
//  - incoming handshakes from higher up
//    - remember, 
//      this shall be a helper so you can do administrative stuff here 
//      so your actual process logic (picking, dispensing, syncing, gearing) may live elsewhere
// 
//---------------------------------------------------------------------------------------------------------------
//  - InstanceState(_stInstanceState)
//---------------------------------------------------------------------------------------------------------------
//  - reporting to higher up
//
//
//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
//  - basic check and var names, so you can build your procedures with it
//
//  - processes may be connected via linked list, you decide.
//    - linked list for processes is intended to work as job buffer
//    - linked list provides information via ST_PROCESS_DATA, 
//      add what you have to in there
//    - linked list to all process instances provided
//
//  - inherit this base class for your application, call Check() every cycle at the top before you do anything
//       IF NOT Check() THEN 
//         RETURN; 
//       END_IF
//
//---------------------------------------------------------------------------------------------------------------//
// This SOFTWARE is provided as an Example by THE PROVIDER "as is" and "with all faults." THE PROVIDER makes no  //
// representations or warranties of any kind concerning the safety, suitability, lack of viruses, inaccuracies,  //
// typographical errors, or other harmful components of this SOFTWARE. There are inherent dangers in the use of  //
// any software, and you are solely responsible for determining whether this SOFTWARE is compatible with your    //
// equipment and other software installed on your equipment. You are also solely responsible for the protection  //
// of your equipment and backup of your data, and THE PROVIDER will not be liable for any damages you may suffer //
// in connection with using, modifying, or distributing this SOFTWARE.                                           //
//---------------------------------------------------------------------------------------------------------------//
FUNCTION_BLOCK ABSTRACT fb_Instance
VAR
  // process index
  _nProcess               : E_INSTANCE;           // whoami

  _stInstanceCtrl         : REFERENCE TO ARRAY[1..MAX_PROCESS] OF ST_INSTANCE_CTRL;
  _stInstanceState        : REFERENCE TO ARRAY[1..MAX_PROCESS] OF ST_INSTANCE_STATE;

  _eCmd,
  _eCmdOld                : E_INSTANCE_CMD;       // commands for local state machine
  _eStateInstance         : E_INSTANCE_STATE;     // local state machine for infeed procedure

  _eResult                : E_PROGRESS;           // result for methods
  _eStateProgress         : E_PROGRESS;           // substate for local state machine

  _eInit                  : E_PROGRESS;           // startup
  _eCheck                 : E_INSTANCE_CHECK;     // pointer checks

  // local ctrl / state datafields for you to use, connected by reference to _ItfProcessCollector[_nProcess]
  _stCollectorCtrl        : ST_PROCESS_CTRL;      // control to write, connected by reference to _ItfProcessCollector
  _stCollectorState       : ST_PROCESS_STATE;     // state   to read,  connected by reference to _ItfProcessCollector

  _ItfProcessCollector    : ARRAY[1..MAX_PROCESS] OF I_ProcessCollector;    // information and configuration of the connected ProcessCollector for given range of XtsStations

  _ItfProcessList         : ARRAY[1..MAX_PROCESS] OF I_Process_LinkedList;  // access to all linked lists for writing tickets
  _stListResult           : ST_PROCESS_LIST_RESULT;
  _stProcessData          : ST_PROCESS_DATA;

  {attribute 'displaymode':='bin'}
  _wTargetMask            : ARRAY[1..SIZEOF(T_PROCESS)*8] OF BYTE; // bits for PosStop[] to use in XtsStation of target process

  // position window a mover must be in in order for instance to react
  // value in abs modulo axis value
  //  - crossing the modulo turn is evaluated --> (Start > End) case is valid as window
  _rCheckPositionStart    : LREAL;
  _rCheckPositionEnd      : LREAL;

  _stMsg                  : ST_Message;
  _MessageLevel           : E_MessageType;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="properties" Id="{3fc25e2e-f78a-4e4b-8f93-14def1aa86a2}" />
    <Method Name="Check" Id="{9cd29f0b-abaf-4789-854c-ec925ea6b0ca}">
      <Declaration><![CDATA[METHOD Check : BOOL // call this method in the extending/inheriting class
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// plausibility checks
//-----------------------------------------------------------------------------
IF NOT (_nProcess > 0)
THEN
  _eCheck                 := E_INSTANCE_CHECK.PROCESS_ID_ZERO;
  RETURN;
END_IF

IF NOT (_nProcess < E_INSTANCE.INSTANCE_MAX)
THEN
  _eCheck                 := E_INSTANCE_CHECK.PROCESS_ID_MAX;
  RETURN;
END_IF
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// pointer checks
//-----------------------------------------------------------------------------
IF NOT __ISVALIDREF(_stInstanceCtrl)
THEN
  _eCheck                 := E_INSTANCE_CHECK.INVALID_INSTANCE_CONTROL_REFERENCE;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stInstanceState)
THEN
  _eCheck                 := E_INSTANCE_CHECK.INVALID_INSTANCE_STATE_REFERENCE;
  RETURN;
END_IF

IF NOT (_ItfProcessCollector[_nProcess] <> 0) 
THEN
  _eCheck                 := E_INSTANCE_CHECK.POINTER_COLLECTOR_ITF_INVALID;
  RETURN;
END_IF

IF NOT (_ItfProcessCollector[_nProcess].ProcessId > 0)
THEN
  _eCheck                 := E_INSTANCE_CHECK.PROCESS_ID_ZERO;
  RETURN;
END_IF

IF NOT (_ItfProcessCollector[_nProcess].ProcessId < E_INSTANCE.INSTANCE_MAX)
THEN
  _eCheck                 := E_INSTANCE_CHECK.PROCESS_ID_MAX;
  RETURN;
END_IF

IF NOT (_nProcess = _ItfProcessCollector[_nProcess].ProcessId)
THEN
  _eCheck                 := E_INSTANCE_CHECK.PROCESS_ID_NOTEQUAL_COLLECTOR_ID;
  RETURN;
END_IF

IF NOT (_ItfProcessList[_nProcess] <> 0)
THEN
  _eCheck                 := E_INSTANCE_CHECK.PROCESS_LIST_ITF_INDEX_INVALID;
  RETURN;
END_IF
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// connect datafields to interface of ProcessCollector
//-----------------------------------------------------------------------------
_ItfProcessCollector[_nProcess].ProcessCtrl   REF= _stCollectorCtrl;
_ItfProcessCollector[_nProcess].ProcessState  REF= _stCollectorState;

//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// set message device
//-----------------------------------------------------------------------------
_stMsg.eDevice            := e_Device.Process + TO_UINT(_nProcess);
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
_eCheck                   := E_INSTANCE_CHECK.CHECK_DONE;
Check                     := TRUE;


]]></ST>
      </Implementation>
    </Method>
    <Property Name="CheckPositionEnd" Id="{611133ef-1aa7-4cac-8c52-cbfc3d44858b}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY CheckPositionEnd : lreal // end of the position window to execute logic (should be higher than the WaitPos this instance is working on)]]></Declaration>
      <Get Name="Get" Id="{220e427a-8106-496d-8e02-efe34fe069d3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CheckPositionEnd := _rCheckPositionEnd;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{3c54014d-4c7a-4e01-845f-ae2fc227ec95}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_rCheckPositionEnd := CheckPositionEnd;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="CheckPositionStart" Id="{74147dd9-e508-4775-99ef-aeb3905c9fab}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY CheckPositionStart : lreal // start of the position window to execute instance logic]]></Declaration>
      <Get Name="Get" Id="{02431a8b-a3c4-49ec-816f-3fbbb6eb28a7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CheckPositionStart := _rCheckPositionStart;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{49a13307-7d3e-4cb3-a294-b3105053b320}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_rCheckPositionStart := CheckPositionStart;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="CmdLog" Id="{59b1c5ef-8900-4988-bf5d-ece023138df6}">
      <Declaration><![CDATA[METHOD CmdLog
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF (_MessageLevel > E_MessageType.eMessageError)
THEN
  _stMsg.eSubdevice       := e_Subdevice.Instance_Command;
  _stMsg.iErrorNumber     := _nProcess;
  _stMsg.sText            := concat('E_INSTANCE_CMD', '.');
  _stMsg.sText            := concat(_stMsg.sText, TO_STRING(_eCmd));
  f_MessageSet(_stMsg);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="CollectorInterface" Id="{1778065e-71fc-4b61-95e9-f0ce7344fd52}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY CollectorInterface : array[1..MAX_PROCESS] of I_ProcessCollector]]></Declaration>
      <Set Name="Set" Id="{efa86bb5-063c-45e0-824e-e0c7dd62a865}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ItfProcessCollector := CollectorInterface;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="InstanceCtrl" Id="{981757e0-8e40-45aa-8057-0491d6ad023f}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY InstanceCtrl : REFERENCE TO ARRAY[1..MAX_PROCESS] OF ST_INSTANCE_CTRL]]></Declaration>
      <Set Name="Set" Id="{c8e80f92-c362-4f41-b0f9-db9dbea0e4aa}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_stInstanceCtrl ref= InstanceCtrl;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="InstanceState" Id="{c8bdcdf1-4ecd-4637-8eac-c66b80a81d6a}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY InstanceState : REFERENCE TO ARRAY[1..MAX_PROCESS] OF ST_INSTANCE_STATE]]></Declaration>
      <Set Name="Set" Id="{03b5b73e-3a6b-4866-9a71-452e2580c4e5}">
        <Declaration><![CDATA[
VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_stInstanceState ref= InstanceState;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="MessageLevel" Id="{14a41416-0811-40c7-bca5-c73484c900e8}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY MessageLevel : e_MessageType]]></Declaration>
      <Get Name="Get" Id="{55960fd5-ef50-4cb1-ac26-92fb20141955}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MessageLevel := _MessageLevel;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{919b1481-002a-4dbe-8ca4-b1c293d8d704}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_MessageLevel := MessageLevel;

IF NOT (_eInit  = E_PROGRESS.PROGRESS_DONE) OR
   NOT (_eCheck = E_INSTANCE_CHECK.CHECK_DONE)
THEN
  RETURN;
ELSE
  _ItfProcessCollector[_nProcess].MessageLevel := _MessageLevel;
END_IF]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ProcessId" Id="{0e2c48f6-df86-4fbb-8e57-b52b71d7cbbe}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY ProcessId : E_INSTANCE]]></Declaration>
      <Get Name="Get" Id="{f8401d20-eb74-43d4-9fe4-3c8cf8a9917e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ProcessId := _nProcess;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{a4eb999b-e525-42f5-b031-b3d17e5e8ef9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_nProcess := ProcessId;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ProcessLinkedLists" Id="{2f89974a-bbab-4971-8579-59c8d4c1391a}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY ProcessLinkedLists : ARRAY[1..max_process] OF I_Process_LinkedList]]></Declaration>
      <Set Name="Set" Id="{f0e2969e-ffb1-4ccd-ace6-2a5cd31e132b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ItfProcessList := ProcessLinkedLists;
]]></ST>
        </Implementation>
      </Set>
    </Property>
