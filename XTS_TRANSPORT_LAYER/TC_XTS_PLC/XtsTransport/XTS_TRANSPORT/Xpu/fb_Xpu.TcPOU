    <Method Name="XpuStartUp" Id="{d06cfee0-66fa-4431-a643-e9547a6c38d6}" FolderPath="methods\">
      <Declaration><![CDATA[METHOD XpuStartUp : E_XPU_INIT
VAR_INPUT
  Execute         : BOOL;
END_VAR
VAR_IN_OUT
  _eReslt       : E_PROGRESS;     // send info about progress to caller
  _eChk         : E_XPU_CHECK;
END_VAR
VAR_INST
  _eState           : E_PROGRESS;   // progress state
  _nState           : E_XPU_INIT;   // initialization state
  _eDataGetCount    : E_PROGRESS;   // cycle counter to catch exceeding wait time for data from ProcessingUnit

  _nParaSetIdx      : UINT;

  _nMoverIdx,
  _nModuleIdx       : UINT;

  _nNctBaseUnitIdx  : UINT;
  _nTaskIndex       : DINT;   // PLC task index
  _nCycleTime       : UDINT;  // cycle time in [100 ns] --> _nCycleTime/10000 --> [ms]

  _stVersionXpu     : XTS.TcVersion;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
// clear progress on request
IF NOT Execute 
THEN 
  _eState                           := E_PROGRESS.PROGRESS_INIT;
  _eDataGetCount                    := 0;
 
  XpuStartUp                        :=
  _nState                           := E_XPU_INIT.INIT_START;

  _nTaskIndex                       := GETCURTASKINDEXEX();
  IF (_nTaskIndex > 0)
  THEN
      _nCycleTime                   := _TaskInfo[_nTaskIndex].CycleTime;
  END_IF

  RETURN; 
END_IF
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
// progress state
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_INIT:         // clear start
    IF Execute
    THEN
      _eState                       := E_PROGRESS.PROGRESS_BUSY;
      _eChk                         := E_XPU_CHECK.INIT_CHECK;    // clear cyclic check state
      _sVersionNctController        :=
      _sVersionXpu                  := TO_STRING(_eChk);          // clear Version string

      // always initialize environment function blocks to get defined start of progress
      _fbEnvironment.Init(FALSE);
      _fbEnvironment.GetXpuOids(FALSE);
      _fbEnvironment.GetInfoServerOids(FALSE);

      // clear initialization states
      _nState                       := E_XPU_INIT.INIT_START;

      // clear check bits
      _bAllPositionsValid           :=
      _bMoverIdDetectionValid       :=
      _bMoverIdDetectionError       := FALSE;

      // clear check values
      _nLengthXpu                   :=
      _nLengthGroup                 :=
      _nDetectedMoverCount          :=
      _nExpectedMoverCount          := 0;

      // clear work values
      _nNctBaseUnitCount            :=
      _nNctBaseUnitIdx              :=
      _nParameterSetCount           :=
      _nInfoServerCount             :=
      _nIfoStationCount             :=
      _nPartCount                   :=
      _nTrackCount                  :=
      _nTaskCount                   :=
      _nMoverCount                  :=
      _nModuleCount                 :=
      _nMoverIdx                    :=
      _nModuleIdx                   := 0;

      //IF (_eMessageLevel > E_MessageType.eMessageWarning)
      //THEN
        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbEnvironment;
        _stMsg.iErrorNumber         := 0;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_eChk));
        f_MessageSet(_stMsg);
      //END_IF
    END_IF
END_CASE
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_BUSY:         // begin with initializing environment
    CASE _nState
    OF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_START:                       // call initialization of environment

    IF NOT _fbEnvironment.P_IsInitialized
    THEN
      _fbEnvironment.Init(TRUE);
    END_IF

    IF (_fbEnvironment.bError)
    THEN
      _eChk                         := E_XPU_CHECK.INIT_CHECK_ERROR;
                                    
      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbEnvironment;
      _stMsg.iErrorNumber           := 666;
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_eChk));
      f_MessageSet(_stMsg);

      _eState                       := E_PROGRESS.PROGRESS_ERROR;

    // get information about success in Property (P_<function>)
    ELSIF _fbEnvironment.P_IsInitialized
    THEN
      // now environment is initialized
     
      //---------------------------------------------------------------------
      // use of library interfaces
      // strict initialization of all interfaces
      //---------------------------------------------------------------------
      IF _fbEnvironment.GetXpuOids(TRUE) // get object IDs for all processing units
      THEN
        _fbEnvironment.Init(FALSE);     // clear environment init
        _nState                     := INIT_ENVIRONMENT_OID;

        IF (_eMessageLevel > E_MessageType.eMessageWarning)
        THEN
          _stMsg.eType              := E_MessageType.eMessageInfo;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbEnvironment;
          _stMsg.iErrorNumber       := 0;
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));
          f_MessageSet(_stMsg);
        END_IF
      END_IF
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_ENVIRONMENT_OID:             // get processing unit object ID for THIS instance
    _Xpu_OTCID                      := _fbEnvironment.P_XpuOids[_nXpu];   // fb_Xpu.XpuInstance --> _nXpu

    _ItfProcessingUnit              := _fbEnvironment.XpuTcIo(_nXpu);     // get interface for this XPU


    IF (_eMessageLevel > E_MessageType.eMessageInfo)
    THEN
      _stMsg.eType                  := E_MessageType.eMessageVerbose;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbEnvironment;
      _stMsg.iErrorNumber           := _Xpu_OTCID;
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_nState));
      _stMsg.sText                  := concat(_stMsg.sText, ': 0x');
      _stMsg.sText                  := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Xpu_OTCID,8,FALSE));

      f_MessageSet(_stMsg);
    END_IF

    // clear all local object IDs
    memset(ADR(_Part_OTCID)         , 0, SIZEOF(_Part_OTCID));
    memset(ADR(_Track_OTCID)        , 0, SIZEOF(_Track_OTCID));
    memset(ADR(_Mov_OTCID)          , 0, SIZEOF(_Mov_OTCID));
    memset(ADR(_Module_OTCID)       , 0, SIZEOF(_Module_OTCID));
    memset(ADR(_ParameterSet_OTCID) , 0, SIZEOF(_ParameterSet_OTCID));

    // clear function blocks
    _fbEnvironment.GetXpuOids           (FALSE);
    _fbEnvironment.GetCaGroupCount      (FALSE);
    _fbEnvironment.GetInfoServerCount   (FALSE);
    _fbEnvironment.GetParameterSetCount (FALSE);

    _eState                         := E_PROGRESS.PROGRESS_PREPARE; // TODO - implement InfoServer R/W
    _nState                         := INIT_CA_GROUP_OID;           // TODO - implement initialization states for info server procedure

    IF NOT (_Xpu_OTCID <> 0) OR
       NOT (_ItfProcessingUnit <> 0)
    THEN
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbProcessingUnit;
      _stMsg.iErrorNumber           := _nXpu;
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_nState));
      _stMsg.sText                  := concat(_stMsg.sText, '_ItfProcessingUnit == 0x');
      f_MessageSet(_stMsg);
    END_IF


  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_INFO_SERVER_ITF:           // HAUD 2024 03 14: TODO - implement procedure for getting Info server data to local datafields
    IF _fbEnvironment.GetInfoServerCount(TRUE)
    THEN
      // how many of you are there?
      _nInfoServerCount             := _fbEnvironment.P_InfoServerCount;

      IF (_nInfoServerCount > 0)
      THEN
        // go do something with the data
        //
        //  TODO - get station coordinates
        _eState                     := E_PROGRESS.PROGRESS_PREPARE; // TODO - implement InfoServer R/W
        _nState                     := INIT_CA_GROUP_OID;           // TODO - implement initialization states for info server procedure

        IF (_eMessageLevel > E_MessageType.eMessageInfo)
        THEN
          _stMsg.eType              := E_MessageType.eMessageVerbose;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbEnvironment;
          _stMsg.iErrorNumber       := 0;
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));
          f_MessageSet(_stMsg);
        END_IF

      ELSE
        // no info server present
        _eState                     := E_PROGRESS.PROGRESS_PREPARE;
        _nState                     := INIT_CA_GROUP_OID; // go check CA group

        IF (_eMessageLevel > E_MessageType.eMessageInfo)
        THEN
          _stMsg.eType              := E_MessageType.eMessageVerbose;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbEnvironment;
          _stMsg.iErrorNumber       := 0;
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));
          f_MessageSet(_stMsg);
        END_IF
      END_IF
    END_IF
  END_CASE
END_CASE
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_PREPARE:      // CA group initialization
  CASE _nState
  OF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_CA_GROUP_OID:                // get object IDs of all CA groups in environment
    IF _fbEnvironment.GetCaGroupOids(TRUE)
    THEN
      _Group_OTCID                  := _fbEnvironment.P_CaGroupOids;  // copy all Ids to local
      _nState                       := INIT_CA_GROUP_GET_OID;
      _fbEnvironment.GetCaGroupOids(FALSE);

      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbEnvironment;
        _stMsg.iErrorNumber         := 0;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_CA_GROUP_GET_OID:            // look for any CA group
    IF NOT (_Group_OTCID[1] <> 0)
    THEN
      // no group is configured in project --> error, go add/link CA Group in NC objects
      _eChk                         := E_XPU_CHECK.GROUP_NOT_CONFIGURED;
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbMc2CaGroup;
      _stMsg.iErrorNumber           := 0;
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_eChk));
      f_MessageSet(_stMsg);
    ELSE
      _nState                       := INIT_CA_GROUP_CHECK_OID; // get matching CA group

      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbEnvironment;
        _stMsg.iErrorNumber         := _Group_OTCID[1];
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        _stMsg.sText                := concat(_stMsg.sText, ': 0x');
        _stMsg.sText                := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Group_OTCID[1],8,FALSE));

        f_MessageSet(_stMsg);
      END_IF
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_CA_GROUP_CHECK_OID:          // ID must be found, there is one chance
    _eChk                           := E_XPU_CHECK.GROUP_OID_MISMATCH;
    _eState                         := E_PROGRESS.PROGRESS_ERROR;

    FOR _ix := 1 TO MAX_GROUP
    DO
      IF (_fbEnvironment.P_CaGroupOids[_ix] <> 0)
      THEN
        // check whether the input from cyclic interface can be found in XPU data
        IF (_fbEnvironment.P_CaGroupOids[_ix] = _CaGroupOID)  // _CaGroupOID must be linked from NC Objects into PLC (GROUP_REF)
        THEN

          _eState                   := E_PROGRESS.PROGRESS_PREPARE; // stay here
          _eChk                     := E_XPU_CHECK.INIT_CHECK;

          _nGroup                   := _ix;
          _ItfMc2CaGroup            := _fbEnvironment.Mc2CaGroup(_nGroup);

          IF NOT (_ItfMc2CaGroup <> 0)
          THEN
            _eState                 := E_PROGRESS.PROGRESS_ERROR;

            _stMsg.eType            := E_MessageType.eMessageError;
            _stMsg.eSubdevice       := e_Subdevice.Xpu_fbMc2CaGroup;
            _stMsg.iErrorNumber     := _CaGroupOID;
            _stMsg.sText            := concat(TO_STRING(_eState), ': ');
            _stMsg.sText            := concat(_stMsg.sText, TO_STRING(_nState));
            _stMsg.sText            := concat(_stMsg.sText, '_ItfMc2CaGroup == 0x');

            f_MessageSet(_stMsg);

          ELSE
            _fbEnvironment.GetCaGroupOids(FALSE);
            _ItfMc2CaGroup.Init(FALSE, _fbEnvironment.P_CaGroupOids[_nGroup]);
  
            IF (_eMessageLevel > E_MessageType.eMessageInfo)
            THEN
              _stMsg.eType          := E_MessageType.eMessageVerbose;
              _stMsg.eSubdevice     := e_Subdevice.Xpu_fbMc2CaGroup;
              _stMsg.iErrorNumber   := _CaGroupOID;
              _stMsg.sText          := concat(TO_STRING(_eState), ': ');
              _stMsg.sText          := concat(_stMsg.sText, TO_STRING(_nState));
              _stMsg.sText          := concat(_stMsg.sText, ': 0x');
              _stMsg.sText          := concat(_stMsg.sText, DWORD_TO_HEXSTR(_CaGroupOID,8,FALSE));
  
              f_MessageSet(_stMsg);
            END_IF
            _nState                 := INIT_CA_GROUP_COM; // only continue if match was found
          END_IF

          EXIT;
        END_IF
      END_IF
    END_FOR

    IF (_eState = E_PROGRESS.PROGRESS_ERROR)
    THEN
      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbMc2CaGroup;
      _stMsg.iErrorNumber           := _nGroup;
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_nState));
      f_MessageSet(_stMsg);
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_CA_GROUP_COM:                // connect to CaGroup function block in environment
    IF (_ItfMc2CaGroup <> 0)
    THEN
      IF (_ItfMc2CaGroup.Init(TRUE, _fbEnvironment.P_CaGroupOids[_nGroup]))
      THEN
        _fbEnvironment.GetParameterSetCount(FALSE);
  
        IF (_eMessageLevel > E_MessageType.eMessageInfo)
        THEN
          _stMsg.eType              := E_MessageType.eMessageVerbose;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbMc2CaGroup;
          _stMsg.iErrorNumber       := _nGroup;
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));
         f_MessageSet(_stMsg);
        END_IF
        _nState                     := INIT_PARAMETERSET_COUNT;
      END_IF
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PARAMETERSET_COUNT:
    IF _fbEnvironment.GetParameterSetCount(TRUE)
    THEN
      _fbEnvironment.GetParameterSetOids(FALSE);
      _nParaSetIdx                  :=
      _nParameterSetCount           := _fbEnvironment.P_ParameterSetCount; // get count for countdown

      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbEnvironment;
        _stMsg.iErrorNumber         := _nParameterSetCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
      _nState                       := INIT_PARAMETERSET_OID;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PARAMETERSET_OID:
    IF (_nParameterSetCount = 0)
    THEN
      _fbEnvironment.GetParameterSetCount(FALSE);
      _eState                       := E_PROGRESS.PROGRESS_STARTUP;
      _nState                       := INIT_PROCESSING_UNIT_COM;

    ELSIF _fbEnvironment.GetParameterSetOids(TRUE)
    THEN
      _fbEnvironment.GetParameterSetCount(FALSE);
      _ParameterSet_OTCID           := _fbEnvironment.P_ParameterSetOids;
      _nState                       := INIT_PARAMETERSET_COM;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PARAMETERSET_COM:
    IF (_nParaSetIdx > 0)
    THEN

      _ItfParameterSet[_nParaSetIdx]  := _fbEnvironment.ParameterSet(_nParaSetIdx);

      IF NOT (_ItfParameterSet[_nParaSetIdx] <> 0)
      THEN
        _eState                     := E_PROGRESS.PROGRESS_ERROR;

        _stMsg.eType                := E_MessageType.eMessageError;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbParameterSet;
        _stMsg.iErrorNumber         := _nParaSetIdx;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        _stMsg.sText                := concat(_stMsg.sText, ': 0x');
        _stMsg.sText                := concat(_stMsg.sText, DWORD_TO_HEXSTR(_ParameterSet_OTCID[_nParaSetIdx],8,FALSE));

        f_MessageSet(_stMsg);

      ELSE
        IF NOT (_ItfParameterSet[_nParaSetIdx].P_IsInitialized)
        THEN
          _ItfParameterSet[_nParaSetIdx].Init(FALSE, _ParameterSet_OTCID[_nParaSetIdx]);
          _nState                   := INIT_PARAMETERSET_COM_INIT;

        ELSE
 
          IF (_eMessageLevel > E_MessageType.eMessageInfo)
          THEN
            _stMsg.eType            := E_MessageType.eMessageVerbose;
            _stMsg.eSubdevice       := e_Subdevice.Xpu_fbParameterSet;
            _stMsg.iErrorNumber     := _ParameterSet_OTCID[_nParaSetIdx];
            _stMsg.sText            := concat(TO_STRING(_eState), ': ');
            _stMsg.sText            := concat(_stMsg.sText, TO_STRING(_nState));
            _stMsg.sText            := concat(_stMsg.sText, ': 0x');
            _stMsg.sText            := concat(_stMsg.sText, DWORD_TO_HEXSTR(_ParameterSet_OTCID[_nParaSetIdx],8,FALSE));
            f_MessageSet(_stMsg);
          END_IF
          _nState                   := INIT_PARAMETERSET_COM_NEXT;
        END_IF
      END_IF
    ELSE
      _fbEnvironment.GetParameterSetOids(FALSE);

      _eState                       := E_PROGRESS.PROGRESS_STARTUP;
      _nState                       := INIT_PROCESSING_UNIT_COM;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PARAMETERSET_COM_INIT:      
    IF (_ItfParameterSet[_nParaSetIdx].Init(TRUE, _ParameterSet_OTCID[_nParaSetIdx]))
    THEN
      _nState                       := INIT_PARAMETERSET_COM;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PARAMETERSET_COM_NEXT:
    _nParaSetIdx                    := _nParaSetIdx - 1; // countdown
    _nState                         := INIT_PARAMETERSET_COM; 
  END_CASE
END_CASE
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STARTUP:      // ProcessingUnit initialization
  CASE _nState
  OF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_COM:         // connect local function block with TcCom object
    IF NOT (_ItfProcessingUnit.P_IsInitialized)
    THEN
      _nState                       := INIT_PROCESSING_UNIT_COM_INIT;
    ELSE
      IF (_eMessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := _nXpu;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        _stMsg.sText                := concat(_stMsg.sText, ': 0x');
        _stMsg.sText                := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Xpu_OTCID,8,FALSE));

        f_MessageSet(_stMsg);
      END_IF

      // local function block can now be used to get information
      // get operation mode first
      _XpuOperationMode             := _ItfProcessingUnit.GetOperationMode();
      _nState                       := INIT_PROCESSING_UNIT_PART_COUNT;
    END_IF


  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_COM_INIT:    // init local function block with OTCID
    IF (_ItfProcessingUnit.Init(TRUE, _Xpu_OTCID))
    THEN
      _nState                         := INIT_PROCESSING_UNIT_COM;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_PART_COUNT:  // get parts in ProcessingUnit
    _nPartCount                     := TO_UINT(_ItfProcessingUnit.GetPartCount());

    IF (_nPartCount > 0)            // one is enough
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := _nPartCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
      _nState                       := INIT_PROCESSING_UNIT_PART_OID;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_PART_OID:    // get object IDs of all parts in ProcessingUNit
    IF _ItfProcessingUnit.GetPartOids()
    THEN
      _Part_OTCID                   := _ItfProcessingUnit.P_PartOids;  // copy IDs to local

      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := _Part_OTCID[1];
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        _stMsg.sText                := concat(_stMsg.sText, ': 0x');
        _stMsg.sText                := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Part_OTCID[1],8,FALSE));
        f_MessageSet(_stMsg);
      END_IF
      _nState                       := INIT_PROCESSING_UNIT_TRACK_COUNT;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_TRACK_COUNT: // how many tracks does this ProcessingUnit have?
    _nTrackCount                    := TO_UINT(_ItfProcessingUnit.GetTrackCount());
  
    IF (_nTrackCount > 0)           // one is enough
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := _nTrackCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF

      _nState                       := INIT_PROCESSING_UNIT_TRACK_OID;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_TRACK_OID:   // get object IDs of all tracks in ProcessingUnit
    IF _ItfProcessingUnit.GetTrackOids()
    THEN
      _Track_OTCID                  := _ItfProcessingUnit.P_TrackOids; // copy IDs to local

      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := _Track_OTCID[1];
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF

      _nState                       := INIT_PROCESSING_UNIT_MOVER_COUNT;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_MOVER_COUNT: // how many of you are there?
    _nMoverCount                    := TO_UINT(_ItfProcessingUnit.GetMoverCount());
  
    IF (_nMoverCount > 0)           // one is enough
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := _nMoverCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF

      _nState                       := INIT_PROCESSING_UNIT_MOVER_OID;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_MOVER_OID:   // get object IDs of all mover in ProcessingUnit
    IF _ItfProcessingUnit.GetMoverOids()
    THEN
      _Mov_OTCID                    := _ItfProcessingUnit.P_MoverOids; // copy IDs to local

      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := 0;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF

      _nState                       := INIT_PROCESSING_UNIT_TASK_COUNT;
      _eChk                         := E_XPU_CHECK.MOVER_COUNT;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_TASK_COUNT:  // how many?
    _nTaskCount                     := TO_UINT(_ItfProcessingUnit.GetTaskCount());
  
    IF (_nTaskCount > 0)
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := _nTaskCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
      _nState                       := INIT_PROCESSING_UNIT_TASK_OID;
    END_IF    

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PROCESSING_UNIT_TASK_OID:    // get their names!
    IF _ItfProcessingUnit.GetTaskOids()
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := _nTaskCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF

      _eState                       := E_PROGRESS.PROGRESS_CHECK;
      _nState                       := INIT_NCT_CONTROLLER_OID;
    END_IF
  END_CASE
END_CASE
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_CHECK:        // NCT
  CASE _nState
  OF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_NCT_CONTROLLER_OID:
    IF (_ItfProcessingUnit.GetNctControllerOid())
    THEN
      _Nct_OTCID                    := _ItfProcessingUnit.P_NctControllerOid;

      IF NOT(_Nct_OTCID > 0)
      THEN
        _eState                     := E_PROGRESS.PROGRESS_OCCUPIED;
      ELSE
        IF (_eMessageLevel > E_MessageType.eMessageInfo)
        THEN
          _stMsg.eType              := E_MessageType.eMessageVerbose;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbNctController;
          _stMsg.iErrorNumber       := _Nct_OTCID;
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));
          _stMsg.sText              := concat(_stMsg.sText, ': 0x');
          _stMsg.sText              := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Nct_OTCID,8,FALSE));

          f_MessageSet(_stMsg);
        END_IF

        _ItfNctController           := _ItfProcessingUnit.NctControllerTcIo();

        _eState                     := E_PROGRESS.PROGRESS_CHECK;
        _nState                     := INIT_NCT_CONTROLLER_COM;
      END_IF
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_NCT_CONTROLLER_COM:
    IF NOT (_ItfNctController <> 0)
    THEN
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbNctController;
      _stMsg.iErrorNumber           := _Nct_OTCID;
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_nState));
      _stMsg.sText                  := concat(_stMsg.sText, '_ItfNctController == 0x');
      f_MessageSet(_stMsg);

    ELSE
      IF NOT (_ItfNctController.P_IsInitialized)
      THEN
        _nState                     := INIT_NCT_CONTROLLER_COM_INIT;
      ELSE
        _sVersionNctController      := _ItfNctController.GetVersionString();
  
        IF (_eMessageLevel > E_MessageType.eMessageInfo)
        THEN
          _stMsg.eType              := E_MessageType.eMessageVerbose;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbNctController;
          _stMsg.iErrorNumber       := _Nct_OTCID;
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));

          f_MessageSet(_stMsg);
        END_IF
        IF (_eMessageLevel > E_MessageType.eMessageError)
        THEN
          _stMsg.eType              := E_MessageType.eMessageInfo;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbNctController;
          _stMsg.iErrorNumber       := _Nct_OTCID;
          _stMsg.sText              := concat('NctController VersionString: ', _sVersionNctController);
          f_MessageSet(_stMsg);
        END_IF
        _nState                     := INIT_NCT_BASE_UNIT_COUNT;
      END_IF
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_NCT_CONTROLLER_COM_INIT:
    IF (_ItfNctController.Init(TRUE, _Nct_OTCID))
    THEN
      _nState                       := INIT_NCT_CONTROLLER_COM;

    ELSIF (_ItfNctController.P_IsInitialized)
    THEN
      _nState                       := INIT_NCT_CONTROLLER_COM;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_NCT_BASE_UNIT_COUNT:
    _nNctBaseUnitCount              := TO_UINT(_ItfNctController.GetBaseUnitInterfaceCount());

    IF NOT (_nNctBaseUnitCount > 0)
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbNctBaseUnit;
        _stMsg.iErrorNumber         := _nNctBaseUnitCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
      _eState                       := E_PROGRESS.PROGRESS_OCCUPIED;
      _nState                       := INIT_DATA_GET;

    ELSE
      IF (_eMessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbNctBaseUnit;
        _stMsg.iErrorNumber         := _nNctBaseUnitCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF

      _nNctBaseUnitIdx              := 1;
      _nState                       := INIT_NCT_BASE_UNIT_ITF;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_NCT_BASE_UNIT_ITF:
    _ItfNctBaseUnit[_nNctBaseUnitIdx] := _ItfNctController.BaseUnitInterfaceTcIo(_nNctBaseUnitIdx);

    IF NOT (_ItfNctBaseUnit[_nNctBaseUnitIdx] <> 0)
    THEN
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbNctBaseUnit;
      _stMsg.iErrorNumber           := _nNctBaseUnitIdx;
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_nState));
      f_MessageSet(_stMsg);
    ELSE
      _nState                       := INIT_NCT_BASE_UNIT_NEXT;
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_NCT_BASE_UNIT_NEXT:
    IF (_nNctBaseUnitIdx > _nNctBaseUnitCount-1)
    THEN
      _eState                       := E_PROGRESS.PROGRESS_OCCUPIED;
      _nState                       := INIT_DATA_GET;

      IF (_eMessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := _nNctBaseUnitCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
    ELSE
      _nNctBaseUnitIdx              := _nNctBaseUnitIdx + 1;
      _nState                       := INIT_NCT_BASE_UNIT_ITF;

      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbNctBaseUnit;
        _stMsg.iErrorNumber         := _nNctBaseUnitIdx;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
    END_IF
  END_CASE
END_CASE
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_OCCUPIED:     // reserve
    _eState                         := E_PROGRESS.PROGRESS_WORKING;
END_CASE
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_WORKING:      // reserve
    _eState                         := E_PROGRESS.PROGRESS_STILL_WORKING;
    _nState                         := INIT_TRACK_COM;
END_CASE
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
CASE _eState
OF
  E_PROGRESS.PROGRESS_STILL_WORKING:// connect local instances of track, part, modules and mover
  CASE _nState
  OF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_TRACK_COM:                   // get Interface Object for my track (_nTrack is fixed to 1 in this example; multi track is not intended)
    _ItfXpuTrack[_nTrack]           := _ItfProcessingUnit.TrackTcIo(_nTrack);

    IF NOT (_ItfXpuTrack[_nTrack] <> 0)
    THEN
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbXpuTrack;
      _stMsg.iErrorNumber           := _nTrack;
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_nState));
      _stMsg.sText                  := concat(_stMsg.sText, '_ItfXpuTrack[_nTrack] == 0x');
      f_MessageSet(_stMsg);

    ELSE
      IF NOT (_ItfXpuTrack[_nTrack].P_IsInitialized)
      THEN
        _ItfXpuTrack[_nTrack].Init(FALSE, _Track_OTCID[_nTrack]);
        _nState                     := INIT_TRACK_COM_INIT;

      ELSE
        IF (_eMessageLevel > E_MessageType.eMessageInfo)
        THEN
          _stMsg.eType              := E_MessageType.eMessageVerbose;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbXpuTrack;
          _stMsg.iErrorNumber       := _nTrack;
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));
          _stMsg.sText              := concat(_stMsg.sText, ': 0x');
          _stMsg.sText              := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Track_OTCID[_nTrack],8,FALSE));

          f_MessageSet(_stMsg);
        END_IF

        _nState                     := INIT_PART_COM;
      END_IF
    END_IF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_TRACK_COM_INIT:                   // init my track (_nTrack is fixed to 1 in this example; multi track is not intended)
    IF (_ItfXpuTrack[_nTrack].Init(TRUE,_Track_OTCID[_nTrack]))
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbXpuTrack;
        _stMsg.iErrorNumber         := _nTrack;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
      _nState                       := INIT_TRACK_COM;

    ELSIF (_ItfXpuTrack[_nTrack].P_IsInitialized) 
    THEN
      _nState                       := INIT_TRACK_COM;
    END_IF
  //-----------------------------------------------------------------------------------------------
  // init part[1]
  //-----------------------------------------------------------------------------------------------
  INIT_PART_COM:                    // get interface object for my part (also fixed to 1 part per ProcessingUnit; multi part is not intended
    _ItfXpuPart[1]                  := _ItfProcessingUnit.PartTcIo(1);

    IF NOT (_ItfXpuPart[1] <> 0)
    THEN
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbXpuPart;
      _stMsg.iErrorNumber           := _nTrack;
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_nState));
      _stMsg.sText                  := concat(_stMsg.sText, '_ItfXpuPart[1] == 0x');
      f_MessageSet(_stMsg);

    ELSE
      IF NOT (_ItfXpuPart[1].P_IsInitialized)
      THEN
        _ItfXpuPart[1].Init(FALSE, _Part_OTCID[1]);
        _nState                     := INIT_PART_COM_INIT;
      ELSE
        IF (_eMessageLevel = E_MessageType.eMessageVerbose)
        THEN
          _stMsg.eType              := E_MessageType.eMessageVerbose;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbXpuPart;
          _stMsg.iErrorNumber       := _Part_OTCID[1];
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));
          _stMsg.sText              := concat(_stMsg.sText, ': 0x');
          _stMsg.sText              := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Part_OTCID[1],8,FALSE));

          f_MessageSet(_stMsg);
        END_IF

        _nState                     := INIT_PART_MODULE_COUNT;
      END_IF
    END_IF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PART_COM_INIT:                    // init my part (also fixed to 1 part per ProcessingUnit; multi part is not intended)
    IF (_ItfXpuPart[1].Init(TRUE, _Part_OTCID[1]))
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbXpuPart;
        _stMsg.iErrorNumber         := _Part_OTCID[1];
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF

      _nState                       := INIT_PART_COM;

    ELSIF (_ItfXpuPart[1].P_IsInitialized)
    THEN
      _nState                       := INIT_PART_COM;
    END_IF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PART_MODULE_COUNT:           // get count of motor modules
    _nModuleCount                   := TO_UINT(_ItfXpuPart[1].GetModuleCount());
  
    IF (_nModuleCount > 0)          // one is enough
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbXpuPart;
        _stMsg.iErrorNumber         := _nModuleCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF

      _nState                       := INIT_PART_MODULE_OID;
    END_IF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PART_MODULE_OID:             // get object IDs of all motor modules in part
    IF _ItfXpuPart[1].GetModuleOids()
    THEN
      _Module_OTCID                 := _ItfXpuPart[1].P_ModuleOids; // copy IDs to local
  
      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbPartModules;
        _stMsg.iErrorNumber         := _nModuleCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF

      _nState                       := INIT_PART_MODULE_COM;    // go, connect module IDs
      _nModuleIdx                   := 1;                       // start at first module
    END_IF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PART_MODULE_COM:           // connect to TcCom object
    _ItfPartModules[_nModuleIdx]    := _ItfXpuPart[1].ModuleTcIo(_nModuleIdx);

    IF NOT (_ItfPartModules[_nModuleIdx] <> 0)
    THEN
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbPartModules;
      _stMsg.iErrorNumber           := _Module_OTCID[_nModuleIdx];
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_nState));
      _stMsg.sText                  := concat(_stMsg.sText, '_ItfPartModules[_nModuleIdx] == 0x');
      f_MessageSet(_stMsg);

    ELSE
      IF NOT (_ItfPartModules[_nModuleIdx].P_IsInitialized)
      THEN
        _ItfPartModules[_nModuleIdx].Init(FALSE, _Module_OTCID[_nModuleIdx]);
        _nState                     := INIT_PART_MODULE_COM_INIT;

      ELSE
        IF (_eMessageLevel > E_MessageType.eMessageInfo)
        THEN
          _stMsg.eType              := E_MessageType.eMessageVerbose;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbPartModules;
          _stMsg.iErrorNumber       := _nModuleIdx;
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));
          _stMsg.sText              := concat(_stMsg.sText, ': 0x');
          _stMsg.sText              := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Module_OTCID[_nModuleIdx],8,FALSE));

          f_MessageSet(_stMsg);
        END_IF

        _nState                     := INIT_PART_MODULE_COM_NEXT;
      END_IF
    END_IF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_PART_MODULE_COM_INIT:           // connect to TcCom object
    IF (_ItfPartModules[_nModuleIdx].Init(TRUE, _Module_OTCID[_nModuleIdx]))
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbPartModules;
        _stMsg.iErrorNumber         := _nModuleIdx;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        _stMsg.sText                := concat(_stMsg.sText, ': 0x');
        _stMsg.sText                := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Module_OTCID[_nModuleIdx],8,FALSE));

        f_MessageSet(_stMsg);
      END_IF

      _nState                       := INIT_PART_MODULE_COM;

    ELSIF (_ItfPartModules[_nModuleIdx].P_IsInitialized)
    THEN
      _nState                       := INIT_PART_MODULE_COM;
    END_IF
  //-----------------------------------------------------------------------------------------------
  INIT_PART_MODULE_COM_NEXT:
    IF (_nModuleIdx > _nModuleCount-1)
    THEN
      // all data from modules collected, continue to mover data
      _nState                       := INIT_MOVER_COM;          // go, connect mover IDs 
      _nMoverIdx                    :=  1;                      // start at first mover

      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbMoverXpu;
        _stMsg.iErrorNumber         := _nMoverCount;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
    ELSE
      // still data to fetch, increment search index, go back to fetching data
      _nState                       := INIT_PART_MODULE_COM;    // go back for next
      _nModuleIdx                   := _nModuleIdx + 1;         // next
    END_IF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_MOVER_COM:                   // connect to interface object
    _ItfMoverXpu[_nMoverIdx]        := _ItfProcessingUnit.MoverTcIo(_nMoverIdx);

    IF NOT (_ItfMoverXpu[_nMoverIdx] <> 0)
    THEN
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbMoverXpu;
      _stMsg.iErrorNumber           := _Mov_OTCID[_nMoverIdx];
      _stMsg.sText                  := concat(TO_STRING(_eState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_nState));
      _stMsg.sText                  := concat(_stMsg.sText, '_ItfMoverXpu[_nMoverIdx] == 0x');
      f_MessageSet(_stMsg);

    ELSE
      IF NOT (_ItfMoverXpu[_nMoverIdx].P_IsInitialized)
      THEN
        _ItfMoverXpu[_nMoverIdx].Init(FALSE, _Mov_OTCID[_nMoverIdx]);
        _nState                     := INIT_MOVER_COM_INIT;

      ELSE
        IF (_eMessageLevel > E_MessageType.eMessageInfo)
        THEN
          _stMsg.eType              := E_MessageType.eMessageVerbose;
          _stMsg.eSubdevice         := e_Subdevice.Xpu_fbMoverXpu;
          _stMsg.iErrorNumber       := _nMoverIdx;
          _stMsg.sText              := concat(TO_STRING(_eState), ': ');
          _stMsg.sText              := concat(_stMsg.sText, TO_STRING(_nState));
          _stMsg.sText              := concat(_stMsg.sText, ': 0x');
          _stMsg.sText              := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Mov_OTCID[_nMoverIdx],8,FALSE));

          f_MessageSet(_stMsg);
        END_IF

        _nState                     := INIT_MOVER_COM_NEXT;
      END_IF
    END_IF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_MOVER_COM_INIT:                   // init mover object
    IF (_ItfMoverXpu[_nMoverIdx].Init(TRUE, _Mov_OTCID[_nMoverIdx]))
    THEN
      IF (_eMessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbMoverXpu;
        _stMsg.iErrorNumber         := _nMoverIdx;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        _stMsg.sText                := concat(_stMsg.sText, ': 0x');
        _stMsg.sText                := concat(_stMsg.sText, DWORD_TO_HEXSTR(_Mov_OTCID[_nMoverIdx],8,FALSE));

        f_MessageSet(_stMsg);
      END_IF

      _nState                       := INIT_MOVER_COM;

    ELSIF (_ItfMoverXpu[_nMoverIdx].P_IsInitialized)
    THEN
      _nState                       := INIT_MOVER_COM;
    END_IF
  //-----------------------------------------------------------------------------------------------
  INIT_MOVER_COM_NEXT:
    IF (_nMoverIdx > _nMoverCount-1)
    THEN
      // all done
      _nState                       := INIT_DATA_GET;           // get important data from ProcessingUnit etc...

      IF (_eMessageLevel > E_MessageType.eMessageInfo)
      THEN
        _stMsg.eType                := E_MessageType.eMessageVerbose;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := 0;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
    ELSE
      // more data to fetch, increment search index and go back
      _nMoverIdx                    := _nMoverIdx + 1;      // next

      IF (_eMessageLevel > E_MessageType.eMessageVerbose)
      THEN
        _stMsg.eType                := E_MessageType.eMessageSentient;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbMoverXpu;
        _stMsg.iErrorNumber         := _nMoverIdx;
        _stMsg.sText                := concat(TO_STRING(_eState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nState));
        f_MessageSet(_stMsg);
      END_IF
      _nState                       := INIT_MOVER_COM;      // go back for next
    END_IF
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_DATA_GET:                    // get data, add more if your application requires it
    // start counter
    _eDataGetCount                  := _eDataGetCount + 1;
    IF (_eDataGetCount MOD E_PROGRESS.PROGRESS_ERROR = 0)
    THEN
      _eState                       := E_PROGRESS.PROGRESS_ERROR;
      _eCheck                       := E_XPU_CHECK.PROCESSING_UNIT_GET_DATA_EXCEED;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbProcessingUnit;
      _stMsg.iErrorNumber           := _nMoverIdx;
      _stMsg.sText                  := concat(TO_STRING(_nState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_eCheck));
      f_MessageSet(_stMsg);
    END_IF
    // wait for plausible data from members
    IF (_bAllPositionsValid) AND
       (_nLengthXpu > 0)
    THEN
      _nState                       := INIT_DATA_CHECK;
      _eChk                         := E_XPU_CHECK.PROCESSING_UNIT_POSITIONS_VALID;

      IF (_eMessageLevel > E_MessageType.eMessageError)
      THEN
        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbProcessingUnit;
        _stMsg.iErrorNumber         := 0;
        _stMsg.sText                := concat(TO_STRING(_nState), ': ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(E_XPU_CHECK.PROCESSING_UNIT_POSITIONS_VALID));
        f_MessageSet(_stMsg);

        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbXpuPart;
        _stMsg.iErrorNumber         := 0;
        _stMsg.sText                := concat(TO_STRING(_nState), ': RailLengthXpu: ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nLengthXpu));
        f_MessageSet(_stMsg);

        _stMsg.eType                := E_MessageType.eMessageInfo;
        _stMsg.eSubdevice           := e_Subdevice.Xpu_fbXpuPart;
        _stMsg.iErrorNumber         := 0;
        _stMsg.sText                := concat(TO_STRING(_nState), ': RailLengthGroup: ');
        _stMsg.sText                := concat(_stMsg.sText, TO_STRING(_nLengthGroup));
        f_MessageSet(_stMsg);
      END_IF
    END_IF

    _bAllPositionsValid             := _ItfProcessingUnit.GetAreAllPositionsValid();
    _nDetectedMoverCount            := TO_UINT(_ItfProcessingUnit.GetDetectedMoverCount());
    _nExpectedMoverCount            := TO_UINT(_ItfProcessingUnit.GetExpectedMoverCount());

    _XpuOperationMode               := _ItfProcessingUnit.GetOperationMode();
    _MoverIdDetectionMode           := _ItfProcessingUnit.GetMoverIdDetectionMode();

    _RailLengthXpu                  := _ItfXpuPart[1].GetLength();
    _RailLengthGroup                := _ItfMc2CaGroup.GetRailLength();
    _nLengthXpu                     := TO_UINT(_RailLengthXpu);
    _nLengthGroup                   := TO_UINT(_RailLengthGroup);

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_DATA_CHECK:                  // plausibility checks
    IF NOT (_nDetectedMoverCount = _nExpectedMoverCount)
    THEN
      _eChk                         := E_XPU_CHECK.MOVER_COUNT_NOT_EQUAL; // the thing that must not be
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbProcessingUnit;
      _stMsg.iErrorNumber           := _nMoverIdx;
      _stMsg.sText                  := concat(TO_STRING(_nState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(E_XPU_CHECK.MOVER_COUNT_NOT_EQUAL));
      f_MessageSet(_stMsg);

    ELSIF NOT (_nLengthXpu = _nLengthGroup)
    THEN
      _eChk                         := E_XPU_CHECK.RAIL_LENGTH_COMPARE;   // yet another thing that must not be
      _eState                       := E_PROGRESS.PROGRESS_ERROR;

      _stMsg.eType                  := E_MessageType.eMessageError;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbProcessingUnit;
      _stMsg.iErrorNumber           := _nMoverIdx;
      _stMsg.sText                  := concat(TO_STRING(_nState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(E_XPU_CHECK.RAIL_LENGTH_COMPARE));
      f_MessageSet(_stMsg);
    ELSE
      _stVersionXpu                 := _ItfProcessingUnit.GetVersion();
      _sVersionXpu                  := TO_STRING(_stVersionXpu.Major);
      _sVersionXpu                  := concat(_sVersionXpu, '.');
      _sVersionXpu                  := concat(_sVersionXpu, TO_STRING(_stVersionXpu.Minor));
      _sVersionXpu                  := concat(_sVersionXpu, '.');
      _sVersionXpu                  := concat(_sVersionXpu, TO_STRING(_stVersionXpu.Build));
      _sVersionXpu                  := concat(_sVersionXpu, '.');
      _sVersionXpu                  := concat(_sVersionXpu, TO_STRING(_stVersionXpu.Revision));

      _eChk                         := E_XPU_CHECK.CHECK_DONE;
      _nState                       := INIT_DONE;                         // write success
    END_IF

  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  INIT_DONE:
    _eState                         := E_PROGRESS.PROGRESS_DONE;          // method is done
    IF (_eMessageLevel > E_MessageType.eMessageError)
    THEN
      _stMsg.eType                  := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbProcessingUnit;
      _stMsg.iErrorNumber           := 0;
      _stMsg.sText                  := concat('Xpu VersionString: ', _sVersionXpu);
      f_MessageSet(_stMsg);

      _stMsg.eType                  := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbProcessingUnit;
      _stMsg.iErrorNumber           := 0;
      _stMsg.sText                  := concat('PLC cycle time [ms]: ', TO_STRING(_nCycleTime/10000));
      f_MessageSet(_stMsg);


      _stMsg.eType                  := E_MessageType.eMessageInfo;
      _stMsg.eSubdevice             := e_Subdevice.Xpu_fbProcessingUnit;
      _stMsg.iErrorNumber           := 0;
      _stMsg.sText                  := concat(TO_STRING(_nState), ': ');
      _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(_eState));
      f_MessageSet(_stMsg);
    END_IF
  END_CASE
END_CASE
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
_eReslt                             := _eState;
XpuStartUp                          := _nState;
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------]]></ST>
