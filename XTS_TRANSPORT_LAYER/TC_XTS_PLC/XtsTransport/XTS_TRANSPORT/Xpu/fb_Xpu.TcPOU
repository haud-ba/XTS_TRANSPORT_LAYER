END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[//
// Who am I?
// Environment may have more than one ProcessingUnit,
// information required for connecting to the correct instance of ProcessingUnit
_nXpu := XpuInstance;
]]></ST>
        </Implementation>
      </Set>
    </Property>
