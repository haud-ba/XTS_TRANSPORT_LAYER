    <Property Name="XpuOtcid" Id="{cbe96801-fe14-4003-8378-097c4e8826b3}" FolderPath="properties\">
      <Declaration><![CDATA[PROPERTY XpuOtcid : OTCID]]></Declaration>
      <Get Name="Get" Id="{3b69688e-e9fb-4717-ba5d-2eb1622e86e9}">
