case _eSelector

  SELECT_MOVER_INDEX:
    _nMoverIndex       := _stCtrl.Mover;

      IF (_nMoverIndex &gt; 0) AND
         (_nMoverIndex &lt; MAX_MOVER+1)
      THEN
        _nAxisId       := _RefAxis[_nMoverIndex].NcToPlc.AxisId;
        _stMoveData    := _stCtrl.Data;

        // get matching state from Cmd
        _eState        := Cmd(_eCmd);
      ELSE
        _nAxisId       := 0;
        _eState        := E_MOVER_STATE.MOVER_NULL;
        _eResult       := E_PROGRESS.PROGRESS_ERROR;
      END_IF


  SELECT_MOVER_AXIS_ID:

    _eSelectorResult   := GetAxisIndex(_stCtrl.Mover);
                       // _nMoverIndex is written by method

    CASE _eSelectorResult
    OF
      E_PROGRESS.PROGRESS_DONE:
        _stMoveData    := _stCtrl.Data;
        _nAxisId       := _RefAxis[_nMoverIndex].NcToPlc.AxisId;
        _stMoveData    := _stCtrl.Data;

        // get matching sdtate from Cmd
        _eState        := Cmd(_eCmd);

      E_PROGRESS.PROGRESS_ERROR:
        _nMoverIndex   := 0;
        _nAxisId       := 0;
        _eState        := E_MOVER_STATE.MOVER_NULL;
        _eResult       := _eSelectorResult;
    END_CASE



